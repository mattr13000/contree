{
  "name": "contree",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"nodemon --exec tsx server/index.js\" \"vite\"",
    "dev:bots": "tsx scripts/dev-bots.js",
    "dev:server": "nodemon --exec tsx server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "tsx server/index.js",
    "typecheck": "tsc"
  },
  "nodemonConfig": {
    "watch": [
      "server"
    ],
    "ext": "js,ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^5.2.0"
  }
}
